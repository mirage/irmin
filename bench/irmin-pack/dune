(executables
 (names main)
 (public_names bench-pack)
 (modules main)
 (package irmin-bench)
 (preprocess
  (pps ppx_irmin.internal ppx_repr))
 (libraries
  irmin-pack
  irmin-test.bench
  unix
  cmdliner
  logs
  repr
  ppx_repr
  bench_common
  mtime
  rusage))

(library
 (name bench_common)
 (public_name irmin-bench.common)
 (modules bench_common import)
 (libraries irmin-pack irmin-pack.unix irmin-tezos unix progress uuidm)
 (preprocess
  (pps ppx_irmin.internal))
 (instrumentation
  (backend bisect_ppx)))

