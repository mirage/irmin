 (libraries
  common
  qcheck-core
  qcheck-stm.stm
  qcheck-stm.sequential
  qcheck-stm.domain_eio
  eio
  eio_main
  irmin
  irmin-test
  irmin-pack
  irmin-pack.mem
  irmin.mem
  irmin-tezos))
